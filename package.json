{
  "name": "expectopatronus00.github.io",
  "version": "1.0.0",
  "description": "AI 驱动的个人科技博客 · 抖音搬运 · 自动化",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "live-server --port=5500 --no-browser",
    "lint": "eslint . --ext .js,.html",
    "lint:fix": "eslint . --ext .js,.html --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint '**/*.css'",
    "lint:css:fix": "stylelint '**/*.css' --fix",
    "check": "npm run lint && npm run lint:css && npm run format:check"
  },
  "devDependencies": {
    "eslint": "^10.5.0",
    "eslint-plugin-html": "^8.1.4",
    "live-server": "^1.2.2",
    "prettier": "^3.8.4",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
