# 通知渠道配置（复制为 .env 后填写，.env 不入库）
# 全部可选，配了哪个走哪个；一个都不配时脚本只打印到终端。

# Telegram Bot（找 @BotFather 建 bot，chat_id 用 @userinfobot 查）
# TG_BOT_TOKEN=123456:ABC-DEF...
# TG_CHAT_ID=123456789

# Bark（iOS，App 首页那串地址）
# BARK_URL=https://api.day.app/你的key

# Server 酱（微信推送，sct.ftqq.com 拿 SendKey）
# SERVERCHAN_KEY=SCTxxxxx

# 飞书自定义机器人
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

# 企业微信群机器人
# WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# 钉钉自定义机器人
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx

# 通用 JSON POST（收到 { "text": "..." }）
# NOTIFY_WEBHOOK=https://example.com/hook

# 邮件（SMTP）。163/126 邮箱要在「设置 → POP3/SMTP/IMAP」开启 SMTP 服务，
# 并用它给的「客户端授权密码」当 EMAIL_SMTP_PASS，登录密码不行。
# EMAIL_SMTP_HOST=smtp.163.com
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_USER=你的邮箱@163.com
# EMAIL_SMTP_PASS=授权密码
# EMAIL_TO=收件人@163.com（不填默认发给 EMAIL_SMTP_USER，多个用逗号分隔）
# EMAIL_FROM_NAME=博客信源雷达

# 站点地址与断更阈值（site-health.cjs 用，不填用默认值）
# SITE_URL=https://expectopatronus00.github.io
# STALE_DAYS=7
